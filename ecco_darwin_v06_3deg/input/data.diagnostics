# Diagnostic Package Choices
#-----------------
# for each output-stream:
#  filename(n) : prefix of the output file name (only 8.c long) for outp.stream n
#  frequency(n):< 0 : write snap-shot output every multiple of |frequency| (iter)
#               > 0 : write time-average output every multiple of frequency (iter)
#  levels(:,n) : list of levels to write to file (Notes: declared as REAL)
#                 when this entry is missing, select all common levels of this list
#  fields(:,n) : list of diagnostics fields (8.c) (see "available_diagnostics" file 
#                 for the list of all available diag. in this particular config)
#--------------------------------------------------------------------
#
 &diagnostics_list
#
  dumpatlast = .TRUE.,

   filename(1) = '2d',
  frequency(1) = 1200.,
   fields( 1,1) = 'DICFsed ',
   fields( 2,1) = 'ALKFsed ',
   fields( 3,1) = 'O2Fsed  ',
   fields( 4,1) = 'POCFbur ',
   fields( 5,1) = 'CALFbur ',
   fields( 6,1) = 'sedFlPOC',
   fields( 7,1) = 'sedFlPIC',
   fields( 8,1) = 'TcorrO2 ',
   fields( 9,1) = 'TcorrALK',
   fields(10,1) = 'TcorrDIC',
   fields(11,1) = 'OmegCbot',
   fields(12,1) = 'fluxCO2 ',
   fields(13,1) = 'gDICsurf',
   fields(14,1) = 'fugfCO2 ',
   fields(15,1) = 'fCO2    ',
   fields(16,1) = 'apCO2   ',
   fields(17,1) = 'apCO2sat',
   fields(18,1) = 'gO2surf ',
   fields(19,1) = 'fluxO2  ',
   fields(20,1) = 'sfcSolFe',
   fields(21,1) = 'gDICEpr ',
   fields(22,1) = 'gNO3Epr ',
   fields(23,1) = 'gNO2Epr ',
   fields(24,1) = 'gNH4Epr ',
   fields(25,1) = 'gPO4Epr ',
   fields(26,1) = 'gFeTEpr ',
   fields(27,1) = 'gSiO2Epr',
   fields(28,1) = 'gALKEpr ',
   fields(29,1) = 'gO2Epr  ',

   filename(2) = '3d',
  frequency(2) = 1200.,
   fields( 1,2) = 'PP      ',
   fields( 2,2) = 'pCO2    ',
   fields( 3,2) = 'pH      ',
   fields( 4,2) = 'CO3     ',
   fields( 5,2) = 'KspTPClc',
   fields( 6,2) = 'OmegaC  ',
   fields( 7,2) = 'C_DIC   ',
   fields( 8,2) = 'C_DICPIC',
   fields( 9,2) = 'respDIC ',
   fields(10,2) = 'rDIC_DOC',
   fields(11,2) = 'rDIC_POC',
   fields(12,2) = 'dDIC_PIC',
   fields(13,2) = 'C_ALK   ',
   fields(14,2) = 'S_ALK   ',
   fields(15,2) = 'C_NO3   ',
   fields(16,2) = 'S_NO3   ',
   fields(17,2) = 'C_NO2   ',
   fields(18,2) = 'S_NO2   ',
   fields(19,2) = 'C_NH4   ',
   fields(20,2) = 'S_NH4   ',
   fields(21,2) = 'C_DIN   ',
   fields(22,2) = 'S_DIN   ',
   fields(23,2) = 'C_PO4   ',
   fields(24,2) = 'S_PO4   ',
   fields(25,2) = 'C_Fe    ',
   fields(26,2) = 'S_Fe    ',
   fields(27,2) = 'sedFe   ',
   fields(28,2) = 'freeFeLs',
   fields(29,2) = 'C_Si    ',
   fields(30,2) = 'S_Si    ',
   fields(31,2) = 'C_O2    ',
   fields(32,2) = 'S_O2    ',
   fields(33,2) = 'CO3     ',
   fields(34,2) = 'KspTPClc',
   fields(35,2) = 'OmegaC  ',
 /

# Parameter for Diagnostics of per level statistics:
#-----------------
# for each output-stream:
#  stat_fname(n) : prefix of the output file name (only 8.c long) for outp.stream n
#  stat_freq(n):< 0 : write snap-shot output every |stat_freq| seconds
#               > 0 : write time-average output every stat_freq seconds
#  stat_phase(n)    : write at time = stat_phase + multiple of |stat_freq|
#  stat_region(:,n) : list of "regions" (default: 1 region only=global)
#  stat_fields(:,n) : list of diagnostics fields (8.c) (see "available_diagnostics.log"
#                 file for the list of all available diag. in this particular config)
#-----------------
 &DIAG_STATIS_PARMS
 /
