# Darwin diagnostics
# ==================
# PAR                 Photosynthetically active radiation
# PP                  Primary production
# Nfix                Nitrogen fixation
# Rstar01             Rstar^PO4 of Phy01
# Diver1              # Phy species over absolute threshold'
# Diver2              # Phy species over threshold for proportion of biomass'
# Diver3              # Phy species constituting bulk of biomass'
# Diver4              # Phy species over threshold for ratio to maximum species'
#
 &diagnostics_list
#
  filename( 1) = 'GR',
  frequency(1) = 2592000.,
# frequency(1) = 31104000.,
  fields( 1,1) = 'GR0001  ',
  fields( 2,1) = 'GR0002  ',
  fields( 3,1) = 'GR0003  ',
  fields( 4,1) = 'GR0004  ',
  fields( 5,1) = 'GR0005  ',
  fields( 6,1) = 'GR0006  ',
  fields( 7,1) = 'GR0007  ',
  fields( 8,1) = 'GR0008  ',
  fields( 9,1) = 'GR0009  ',
  fields(10,1) = 'GR0010  ',
  fields(11,1) = 'GR0011  ',
  fields(12,1) = 'GR0012  ',
  fields(13,1) = 'GR0013  ',
  fields(14,1) = 'GR0014  ',
  fields(15,1) = 'GR0015  ',
  fields(16,1) = 'GR0016  ',
  fields(17,1) = 'GR0017  ',
  fields(18,1) = 'GR0018  ',
  fields(19,1) = 'GR0019  ',
  fields(20,1) = 'GR0020  ',
  fields(21,1) = 'GR0021  ',
  fields(22,1) = 'GR0022  ',
  fields(23,1) = 'GR0023  ',
  fields(24,1) = 'GR0024  ',
  fields(25,1) = 'GR0025  ',
  fields(26,1) = 'GR0026  ',
  fields(27,1) = 'GR0027  ',
  fields(28,1) = 'GR0028  ',
  fields(29,1) = 'GR0029  ',
  fields(30,1) = 'GR0030  ',
  fields(31,1) = 'GR0031  ',
  fields(32,1) = 'GR0032  ',
  fields(33,1) = 'GR0033  ',
  fields(34,1) = 'GR0034  ',
  fields(35,1) = 'GR0035  ',
#
 &

# Parameter for Diagnostics of per level statistics:
#-----------------
# for each output-stream:
#  stat_fname(n) : prefix of the output file name (only 8.c long) for
#outp.stream n
#  stat_freq(n):< 0 : write snap-shot output every |stat_freq| seconds
#               > 0 : write time-average output every stat_freq seconds
#  stat_phase(n)    : write at time = stat_phase + multiple of |stat_freq|
#  stat_region(:,n) : list of "regions" (default: 1 region only=global)
#  stat_fields(:,n) : list of diagnostics fields (8.c) (see
#"available_diagnostics.log"
#                 file for the list of all available diag. in this particular
#config)
#-----------------
 &DIAG_STATIS_PARMS
 diagst_mnc=.FALSE.,
     stat_freq(1:3)= 3*10800.,
    stat_phase(1:3)= 3*0.,
 stat_fields(1,1)= 'PP      '
 stat_fields(1,2)= 'Nfix    '
 stat_fields(1,3)= 'Denit   '
    stat_fname(1)= 'statsPP',
    stat_fname(2)= 'statsNfix',
    stat_fname(3)= 'statsDenit',
 &
